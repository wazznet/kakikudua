<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#113F67"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >


    <ImageView
        android:id="@+id/backtolist"
        android:layout_width="32dp"
        android:layout_height="33dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_arrow_back_24" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="komfirmasi pembayaran"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:background="@drawable/cr18bffffff"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/nama_produk"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:layout_marginTop="20dp"
            android:text="TextView"
            android:textColor="#0B0B0B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/harga_produk"
            android:layout_width="123dp"
            android:layout_height="23dp"
            android:layout_marginTop="16dp"
            android:text="TextView"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nama_produk" />

        <TextView
            android:id="@+id/tujuan"
            android:layout_width="200dp"
            android:layout_height="28dp"
            android:layout_marginStart="172dp"
            android:layout_marginTop="52dp"
            android:text="TextView"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:layout_marginTop="130dp"
            android:background="@drawable/cr8bd9d9d9"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tujuan2"
                android:layout_width="188dp"
                android:layout_height="28dp"
                android:layout_marginTop="24dp"
                android:text="pilih metode pembayaran"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tujuan2">

                <RadioButton
                    android:id="@+id/saldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/baseline_payment_24"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="Saldo Wazzapp"
                    android:textAlignment="textEnd"
                    android:textColor="#000000"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold"
                    android:visibility="visible"
                    tools:visibility="visible" />

                <RadioButton
                    android:id="@+id/SP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/qris"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="QRIS"
                    android:textAlignment="textEnd"
                    android:textColor="#000000"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/BC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/bca"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="BCA"
                    android:textAlignment="textEnd"
                    android:textColor="#040404"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/I1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/bni"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="BNI"
                    android:textAlignment="textEnd"
                    android:textColor="#040404"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/M2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/mandiri"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="mandiri"
                    android:textAlignment="textEnd"
                    android:textColor="#040404"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/BR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="8dp"
                    android:background="@drawable/custom_radio_bg"
                    android:button="@null"
                    android:drawableStart="@drawable/beri"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="BRI"
                    android:textAlignment="textEnd"
                    android:textColor="#040404"
                    android:textColorLink="#0516BD"
                    android:textStyle="bold" />
            </RadioGroup>

            <Button
                android:id="@+id/beli"
                android:layout_width="204dp"
                android:layout_height="61dp"
                android:layout_marginTop="392dp"
                android:text="beli"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tujuan2" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>