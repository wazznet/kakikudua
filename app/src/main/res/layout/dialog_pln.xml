<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="30dp"
    android:background="@drawable/circular_overlay3"
    android:visibility="visible"

    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/layout1"
        android:layout_width="300dp"
        android:layout_height="85dp"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.466"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/pra"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="80dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageViewpenagihan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/pln"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tV_penagihan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prabayar"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pasca"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="80dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imagepembelian"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/pln"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/Gopay"
                android:layout_width="49dp"
                android:layout_height="wrap_content"
                android:text="Pascabayar"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
