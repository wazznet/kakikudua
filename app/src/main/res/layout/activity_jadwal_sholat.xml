<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".client.ClientActivity"
    android:background="#113F67">


    <ImageView
        android:id="@+id/back2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.021"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_arrow_back_24" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Jadwal Sholat"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout11"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="84dp"
        android:background="@drawable/cr18bffffff"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- LOKASI -->
            <TextView
                android:id="@+id/txtWilayah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProvinsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text=""
                android:textColor="#666"
                android:textSize="16sp" />

            <!-- TABEL JADWAL -->
            <TextView
                android:id="@+id/tanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:stretchColumns="1">

                <!-- HEADER -->
                <TableRow android:background="#118EEA">

                    <TextView
                        android:padding="12dp"
                        android:text="Waktu"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="12dp"
                        android:text="Jam"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </TableRow>
                <TableRow android:background="#EEEEEE">

                    <TextView
                        android:padding="12dp"
                        android:text="Imsak" />

                    <TextView
                        android:id="@+id/txtImsak"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

                <!-- SUBUH -->
                <TableRow>

                    <TextView
                        android:padding="12dp"
                        android:text="Subuh" />

                    <TextView
                        android:id="@+id/txtSubuh"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

                <!-- DZUHUR -->
                <TableRow android:background="#EEEEEE">

                    <TextView
                        android:padding="12dp"
                        android:text="Dzuhur" />

                    <TextView
                        android:id="@+id/txtDzuhur"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

                <!-- ASHAR -->
                <TableRow>

                    <TextView
                        android:padding="12dp"
                        android:text="Ashar" />

                    <TextView
                        android:id="@+id/txtAshar"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

                <!-- MAGHRIB -->
                <TableRow android:background="#EEEEEE">

                    <TextView
                        android:padding="12dp"
                        android:text="Maghrib" />

                    <TextView
                        android:id="@+id/txtMaghrib"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

                <!-- ISYA -->
                <TableRow>

                    <TextView
                        android:padding="12dp"
                        android:text="Isya" />

                    <TextView
                        android:id="@+id/txtIsya"
                        android:padding="12dp"
                        android:text=""
                        android:textAlignment="center" />
                </TableRow>

            </TableLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>





