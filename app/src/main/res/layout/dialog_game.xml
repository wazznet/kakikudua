<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="30dp"
    android:background="@drawable/circular_overlay3"
    android:visibility="visible"

    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/textView50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="GAME"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="85dp"
        android:layout_marginTop="96dp"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.47"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ml"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ml"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="MOBILE LEGENDS"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ff"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ff"
                android:textAlignment="center" />

            <TextView
                android:layout_width="49dp"
                android:layout_height="wrap_content"
                android:text="FREE FIRE"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pubg"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/pubg"
                android:textAlignment="center" />

            <TextView
                android:layout_width="49dp"
                android:layout_height="wrap_content"
                android:text="PUBG MOBILE"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout1"
        android:layout_width="300dp"
        android:layout_height="85dp"
        android:layout_marginTop="192dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.47"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/gi"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageViewpenagihan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/pulsa"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tV_penagihan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genshin Impact"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pb"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imagepembelian"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/data"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tV_pembelian"
                android:layout_width="49dp"
                android:layout_height="wrap_content"
                android:text="POINT BLANK"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="6sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ros"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/curved_border"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onLinearLayoutClick"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageriwayat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/emoney"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tV_riwayat"
                android:layout_width="49dp"
                android:layout_height="wrap_content"
                android:text="Rules of Survival "
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="5sp"
                android:textStyle="bold" />
        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
