                <ImageView
                    android:id="@+id/imagelayanan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/layanan"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tV_layanan"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:text="ODP"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="6sp"
                    android:textStyle="bold"
                    tools:ignore="DuplicateIds" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/komplain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:background="@drawable/curved_border"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onLinearLayoutClick"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:visibility="visible"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imagekomplain"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/komplain"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tV_komplain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
