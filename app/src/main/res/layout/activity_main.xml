            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layout1"
            android:layout_width="300dp"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.466"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView">

            <LinearLayout
                android:id="@+id/penagihan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:background="@drawable/curved_border"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onLinearLayoutClick"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:visibility="visible"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imageViewpenagihan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/pembayaran"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tV_penagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tagihan"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/psb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:background="@drawable/curved_border"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onLinearLayoutClick"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:visibility="visible"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imagepembelian"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/newclient"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tV_pembelian"
                    android:layout_width="49dp"
                    android:layout_height="wrap_content"
                    android:text="PSB"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    tools:ignore="DuplicateIds" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/client"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:background="@drawable/curved_border"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onLinearLayoutClick"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:visibility="visible"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imageriwayat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
